{
  "name": "lunchvoice",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test:unit": "node --import tsx --test src/lib/*.test.ts",
    "check:brain": "node scripts/check-agent-brain.mjs",
    "check:release": "node scripts/release-policy.mjs check",
    "check:bundle": "node scripts/check-bundle.mjs dist/assets",
    "check:names": "node scripts/check-customer-names.mjs",
    "check:routes": "node scripts/check-route-layouts.mjs",
    "test:scripts": "node --test scripts/*.test.mjs",
    "test:pr": "npm run check:brain && npm run check:names && npm run check:routes && npm run test:scripts && npm run test:functions && npm run build && npm run check:bundle",
    "test:light": "npm run check:brain && npm run check:names && npm run check:routes && npm run build",
    "test:heavy": "npm run test:light && npm audit --audit-level=high",
    "preview": "vite preview",
    "postinstall": "git config core.hooksPath .githooks || true",
    "test:functions": "node --import tsx --test supabase/functions/_shared/*.test.ts"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@supabase/supabase-js": "^2.58.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.3",
    "jose": "^5.9.6",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vite": "^8.1.3"
  }
}
