{
  "name": "lunchvoice",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/seo-prerender.mjs",
    "test:unit": "node --import tsx --test src/lib/*.test.ts",
    "check:brain": "node scripts/check-agent-brain.mjs",
    "check:release": "node scripts/release-policy.mjs check",
    "check:bundle": "node scripts/check-bundle.mjs dist/assets",
    "check:names": "node scripts/check-customer-names.mjs",
    "check:routes": "node scripts/check-route-layouts.mjs",
    "test:scripts": "node --test scripts/*.test.mjs",
    "test:pr": "npm run check:brain && npm run check:names && npm run check:routes && npm run check:design && npm run test:scripts && npm run test:unit && npm run test:workers && npm run test:functions && npm run build && npm run check:bundle",
    "test:light": "npm run check:brain && npm run check:names && npm run check:routes && npm run check:design && npm run build",
    "test:heavy": "npm run test:light && npm audit --audit-level=high",
    "preview": "vite preview",
    "postinstall": "git config core.hooksPath .githooks || true",
    "test:functions": "node --import tsx --test supabase/functions/_shared/*.test.ts",
    "test:e2e": "node --test --test-concurrency=1 e2e/*.test.mjs",
    "test:workers": "node --import tsx --test workers/*/*.test.ts",
    "check:design": "node scripts/skills.mjs check && node scripts/check-gallery.mjs",
    "skills:sync": "node scripts/skills.mjs sync"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@supabase/supabase-js": "^2.58.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.70.0",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.3",
    "jose": "^5.9.6",
    "playwright": "^1.63.0",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vite": "^8.1.3"
  }
}
