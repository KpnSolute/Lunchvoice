# Per-project MCP secrets for LunchVoice. Names only: never commit real values.
#
#   cp .mcp.env.example .mcp.env
#   chmod 600 .mcp.env        # required: the wrappers refuse a group/world-readable file
#   bash scripts/mcp/doctor.sh
#
# .mcp.env is gitignored. These values are loaded only into the MCP server process for
# this project; they are not read from, or written to, your global shell or account.

# Supabase personal access token used by the project-scoped Supabase MCP server.
# Supabase tokens belong to an ACCOUNT and can reach every project that account can,
# so the MCP server is scoped to one project with --project-ref, not by the token.
# Use a token created for this project and rotate it if it leaks.
SUPABASE_ACCESS_TOKEN=

# Optional overrides (uncomment to change):
# SUPABASE_PROJECT_REF=        # default: project_id in supabase/config.toml
# SUPABASE_MCP_READ_ONLY=true  # set to false ONLY when you intend the MCP server to write
# SUPABASE_MCP_VERSION=0.13.0  # pinned on purpose; upgrade deliberately

# Render (see scripts/mcp/README.md before enabling):
# RENDER_API_KEY=
