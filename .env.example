# LunchVoice v2 frontend. Leave the Supabase values empty to use the dev-only mock API
# (`npm run dev` only; production builds fail closed without them).
VITE_SUPABASE_URL=
# The publishable key (sb_publishable_..., Supabase > Settings > API Keys). Supabase is retiring the legacy anon key;
# VITE_SUPABASE_ANON_KEY is read only when this is empty. Never put a secret key (sb_secret_...) here.
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=
# KpnIdentity issuer, e.g. https://auth.kpnsolute.com (enables the real sign-in flow)
VITE_KPNIDENTITY_ISSUER=

# MCP server secrets (Supabase access token, etc.) no longer live here. They are
# kept per project in a separate gitignored file: see .mcp.env.example and
# scripts/mcp/README.md.
